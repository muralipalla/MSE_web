{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mse-learning-lab.local/schemas/topic.schema.json",
  "title": "MSE topic",
  "type": "object",
  "required": ["id", "domainId", "slug", "title", "summary", "level", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "domainId": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 2 },
    "summary": { "type": "string", "minLength": 20 },
    "prerequisiteTopicIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "level": { "enum": ["foundation", "intermediate", "advanced"] },
    "order": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed", "published", "planned", "retired"] }
  },
  "additionalProperties": true
}
