{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mse-learning-lab.local/schemas/simulation.schema.json",
  "title": "MSE simulation metadata",
  "type": "object",
  "required": ["id", "type", "slug", "title", "topicIds", "outcomeIds", "assumptions", "status", "version"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "simulation" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "topicIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outcomeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "assumptions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "enum": ["draft", "reviewed", "published", "retired"] },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
