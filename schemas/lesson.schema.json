{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mse-learning-lab.local/schemas/lesson.schema.json",
  "title": "MSE lesson metadata",
  "type": "object",
  "required": ["id", "type", "slug", "title", "domainId", "topicIds", "outcomeIds", "status", "version"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "lesson" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "domainId": { "type": "string" },
    "topicIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "outcomeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "level": { "enum": ["foundation", "intermediate", "advanced"] },
    "estimatedMinutes": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed", "published", "retired"] },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
